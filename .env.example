# Local preview remains non-indexable. Use the confirmed HTTPS deployment URL
# for a production build; include its base path when using GitHub project Pages.
SITE_URL=http://127.0.0.1:3000

# Keep false until docs/pre-launch-checklist.md is complete and launch is authorized.
# This does not enable RFQ delivery or make a public preview private.
SEARCH_INDEXING_ENABLED=false

# Optional verification tokens from your own Search Console / Bing Webmaster accounts.
# These are public meta-tag values, not API keys. Leave empty until verified setup.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Public build values. Leave empty until the Cloudflare production bindings and
# server secrets in docs/inquiry-storage-setup.md are configured.
# GitHub Pages cannot host this API; keep these empty in the GitHub Pages build.
NEXT_PUBLIC_RFQ_ENDPOINT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
