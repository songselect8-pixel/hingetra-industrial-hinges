{
  "name": "hingetra-industrial-hinges",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prepare:images": "node scripts/prepare-responsive-images.mjs",
    "prebuild": "npm run prepare:images",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
